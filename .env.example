# ==============================================================================
# OpsBrain Environment Configuration (Template)
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Environment mode: development, testing, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application server settings
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL role used only for database bootstrap and Alembic migrations.
POSTGRES_OWNER_USER=opsbrain_owner
POSTGRES_OWNER_PASSWORD=opsbrain_owner_password
POSTGRES_DB=opsbrain
POSTGRES_PORT=5432

# Least-privilege runtime role used by the API and application tests.
OPSBRAIN_APP_USER=opsbrain_app
OPSBRAIN_APP_PASSWORD=opsbrain_app_password

# API container: connect through the Docker Compose service network.
DATABASE_URL=postgresql+asyncpg://opsbrain_app:opsbrain_app_password@db:5432/opsbrain

# Alembic on the Windows host: use the published host port.
# If POSTGRES_PORT changes, update this port too.
MIGRATION_DATABASE_URL=postgresql+asyncpg://opsbrain_owner:opsbrain_owner_password@127.0.0.1:5432/opsbrain

# Ollama Local Configuration (Endpoint placeholder for Milestone 2+)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:7b
