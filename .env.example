# ==============================================================================
# OpsBrain Environment Configuration (Template)
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Environment mode: development, testing, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application server settings
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=opsbrain_user
POSTGRES_PASSWORD=opsbrain_password
POSTGRES_DB=opsbrain
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL (Async)
DATABASE_URL=postgresql+asyncpg://opsbrain_user:opsbrain_password@db:5432/opsbrain

# Ollama Local Configuration (Endpoint placeholder for Milestone 2+)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:7b
